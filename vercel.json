{
  "version": 2,
  "name": "estacionkusfm",
  "builds": [
    { "src": "server.js", "use": "@vercel/node" },
    { "src": "**/*.html", "use": "@vercel/static" },
    { "src": "css/**", "use": "@vercel/static" },
    { "src": "repro/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "server.js" },
    { "src": "/repro/(.*)", "dest": "/repro/$1" },
    { "src": "/css/(.*)", "dest": "/css/$1" },
    { "src": "/(.*)\.html", "dest": "/$1.html" },
    { "src": "/", "dest": "/index.html" }
  ]
}